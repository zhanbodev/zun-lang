$mod std.math;

$fn degrees(rad) -> Float {
    $# rad * (180.0 / math.pi());
}

$fn radians(deg) -> Float {
    $# deg * (math.pi() / 180.0);
}

$fn tan(x) -> Float {
    $# math.tan(x);
}

$fn sign(n) -> Int {
    $if n > 0 {
        $# 1;
    } $else {
        $if n < 0 {
            $# -1;
        } $else {
            $# 0;
        }
    }
}
